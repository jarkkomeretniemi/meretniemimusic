<?xml version="1.0" encoding="UTF-8"?>
<!-- Jekyll kokoaa tämän automaattisesti kaikista sivuista, joita ei ole piilotettu hakukoneilta. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.html_pages %}
{%- unless p.noindex or p.path contains "kuuntelu/" %}
  <url>
    <loc>https://meretniemimusic.fi{% if p.path == "index.html" %}/{% else %}{{ p.url }}{% endif %}</loc>
    <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
  </url>
{%- endunless %}
{%- endfor %}
</urlset>
